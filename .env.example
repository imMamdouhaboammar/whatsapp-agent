# ==============================================================================
# SECTION 1: REQUIRED RUNTIME CONFIGURATION
# ==============================================================================
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Required when HOST is 0.0.0.0 or exposed through a reverse proxy. Must be at least 24 characters.
# Generate with: openssl rand -hex 32
AGENT_DASHBOARD_TOKEN=

# Model Credentials: Provide either a Gemini API Key OR authenticate via `gcloud auth login`
GEMINI_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Transport Mode: 'baileys' (default self-hosted companion) or 'meta-cloud'
WHATSAPP_TRANSPORT=baileys

# ==============================================================================
# SECTION 2: OPTIONAL PERSISTENCE (Production Supabase / PostgreSQL Tier)
# ==============================================================================
# In production, set DATABASE_URL to your Supabase PostgreSQL pooler or instance.
# When unset, the system runs in Core Minimal Profile with local SQLite WAL.
DATABASE_URL=
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# ==============================================================================
# SECTION 3: OPTIONAL CAPABILITIES & ADVANCED MODULES
# ==============================================================================
# AGENT_CAPABILITIES_OWNER_TOKEN=
# AGENT_AUTOPILOT_BRAND_ID=default

# Simulated Human Typing Pacing (in milliseconds)
MIN_TYPING_DELAY_MS=1500
MAX_TYPING_DELAY_MS=4500

# Meta Cloud API (Only if WHATSAPP_TRANSPORT=meta-cloud)
# META_CLOUD_GRAPH_VERSION=v21.0
# META_CLOUD_PHONE_NUMBER_ID=
# META_CLOUD_BUSINESS_ACCOUNT_ID=
# META_CLOUD_ACCESS_TOKEN=
# META_CLOUD_APP_SECRET=
# META_CLOUD_VERIFY_TOKEN=

# TypeSafe AI Jev Router
# TYPESAFE_API_KEY=
# JEV_ROUTER_ENABLED=true
# JEV_EXTERNAL_ROUTING_ALLOWED=false

# ==============================================================================
# SECTION 4: PUBLIC MARKETING & INTERACTIVE LEAD GENERATION FUNNEL
# ==============================================================================
# WhatsApp sales number without '+' or special characters (e.g. 2010XXXXXXXX)
VITE_SALES_WHATSAPP_NUMBER=201000000000

# Download or documentation URL for DIY self-hosted developers
VITE_FREE_DOWNLOAD_URL=https://github.com/imMamdouhaboammar/whatsapp-agent
