PORT=3000
DATA_DIR=./data

# Google Cloud & Gemini Configuration
# If you are logged in via `gcloud auth login`, the application automatically resolves
# tokens via `gcloud auth print-access-token` and the active project without needing an API key.
# Alternatively, provide a direct Gemini API key:
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=project-3a53318f-795c-46b9-888
GOOGLE_CLOUD_LOCATION=us-central1

# WhatsApp Socket Configuration
# Minimum and maximum simulated typing delay in milliseconds
MIN_TYPING_DELAY_MS=2000
MAX_TYPING_DELAY_MS=5000
