PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# PostgreSQL or Supabase Postgres, server-side only. Keep credentials out of Git.
# Authoritative production database connection string for Supabase PostgreSQL. Supports session pooler (port 5432), transaction pooler (port 6543), and direct IPv6.
DATABASE_URL=

# Required when HOST is accessible outside this machine; use 24+ random characters.
# Publish remote access through an HTTPS reverse proxy.
AGENT_DASHBOARD_TOKEN=

# Owner token for Brand Brain and advanced capability endpoints.
AGENT_CAPABILITIES_OWNER_TOKEN=

# Google Cloud & Gemini Configuration
# If you are logged in via `gcloud auth login`, the application automatically resolves
# tokens via `gcloud auth print-access-token` and the active project without needing an API key.
# Alternatively, provide a direct Gemini API key:
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=project-3a53318f-795c-46b9-888
GOOGLE_CLOUD_LOCATION=us-central1

# TypeSafe AI Jev Router Configuration
# Optional: Routes incoming conversational turns in <300ms to gemini-3.8-flash vs gemini-4-argon
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_ROUTER_ENABLED=true
JEV_CONFIDENCE_THRESHOLD=0.75
JEV_ROUTER_TIMEOUT_MS=800

# WhatsApp Socket Configuration
# Minimum and maximum simulated typing delay in milliseconds
MIN_TYPING_DELAY_MS=2000
MAX_TYPING_DELAY_MS=5000

# Supabase Configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Frontend Supabase (Vite)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sourcery AI Token & Remote MCP
SOURCERY_TOKEN=

# OpenReview GitHub App & Webhook Configuration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_INSTALLATION_ID=
OPENREVIEW_SANDBOX_DRIVER=docker
