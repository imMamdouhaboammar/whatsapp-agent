{
  "name": "fable-agentic-whatsapp",
  "version": "1.0.0",
  "description": "Fully agentic WhatsApp client and AI supervisor powered by Gemini, Baileys browserless transport, and Model Context Protocol",
  "type": "module",
  "scripts": {
    "postinstall": "bun patch-baileys.mjs",
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "mcp": "bun run src/mcp/cli.ts",
    "cli": "bun run src/cli.ts",
    "test": "bun test",
    "db:postgres": "bun run src/persistence/postgres/cli.ts",
    "ui:dev": "bun --cwd ui dev",
    "ui:build": "bun --cwd ui build",
    "ui:astryx": "bun --cwd ui astryx",
    "astryx": "bun --cwd ui astryx",
    "build": "bun --cwd ui build",
    "qlty": "qlty check",
    "qlty:fmt": "qlty fmt",
    "security:audit": "bun run scripts/security-audit.ts"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.119.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "hono": "^4.13.16",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.2.4",
    "@types/qrcode": "^1.5.5"
  }
}
